{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "B00: Gradle clean",
            "type": "shell",
            "command": "./gradlew clean"
        },
        {
            "label": "B01 Gradle build identity-hub",
            "type": "shell",
            "command": "./gradlew  :launchers:identity-hub:build"
        },
        {
            "label": "B02 Gradle build runtime-embedded",
            "type": "shell",
            "command": "./gradlew :launchers:runtime-embedded:build",
            "problemMatcher": []
        },
        {
            "label": "B03 Gradle build catalog-server",
            "type": "shell",
            "command": "./gradlew :launchers:catalog-server:build"
        },
        {
            "label": "B04 Gradle build issuer service",
            "type": "shell",
            "command": "./gradlew :launchers:issuerservice:build"
        },
        {
            "label": "B05 Gradle build digital thread agent",
            "type": "shell",
            "command": "./gradlew :launchers:digital-thread:build"
        },
        {
            "label": "B06 Gradle build Standalone Federated Catalog server",
            "type": "shell",
            "command": "./gradlew :launchers:standalone-federated-catalog:build"
        },
        {
            "label": "B99 Build All",
            "dependsOn": [
                "B01 Gradle build identity-hub",
                "B02 Gradle build runtime-embedded",
                "B03 Gradle build catalog-server",
                "B04 Gradle build issuer service",
                "B05 Gradle build digital thread agent",
                "B06 Gradle build Standalone Federated Catalog server"
            ],
            "dependsOrder": "sequence"
        },
        {
            "label": "PC01 Postgres Consumer Start Postgres",
            "type": "shell",
            "options": {"cwd": "${workspaceFolder}/central-kg"},
            "command": "docker compose up central-platform-postgres",
            "problemMatcher": []
        },
        {
            "label": "PC02 Postgres Consumer Create table",
            "type": "shell",
            "options": {"cwd": "${workspaceFolder}/central-kg"},
            "command": " ./postgres/scripts/create-inserted-table.sh",
            "problemMatcher": []
        },
        {
            "label": "PC03 Postgres Consumer Query inderted datasets",
            "type": "shell",
            "options": {"cwd": "${workspaceFolder}/central-kg"},
            "command": " ./postgres/scripts/query-inserted-assets.sh",
            "problemMatcher": []
        },
        {
            "label": "PC04 Postgres Consumer Delete inserted datasets",
            "type": "shell",
            "options": {"cwd": "${workspaceFolder}/central-kg"},
            "command": " ./postgres/scripts/delete-inserted-assets.sh",
            "problemMatcher": []
        },
        {
            "label": "FC01 Fuseki Consumer Start Fuseki",
            "type": "shell",
            "command": "fuseki/consumer/start_consumer_fuseki.sh",
            "problemMatcher": []
        },
        {
            "label": "FC02 Fuseki Consumer Load Data ",
            "type": "shell",
            "command": "fuseki/consumer/load_data_consumer.sh fuseki/consumer/example_consumer_data.ttl",
            "problemMatcher": []
        },
        {
            "label": "FC03 Fuseki Consumer Wipe Data ",
            "type": "shell",
            "command": "fuseki/consumer/delete_consumer_fuseki.sh",
            "problemMatcher": []
        },
        {
            "label": "FP01 Fuseki Provider Start ",
            "type": "shell",
            "command": "fuseki/provider/start_provider_fuseki.sh",
            "problemMatcher": []
        },
        {
            "label": "FP02 Fuseki Provider Load Data Example",
            "type": "shell",
            "command": "fuseki/provider/load_data_provider.sh demo/dataset_1/subgraph_pc1pc2_external.ttl",
            "problemMatcher": []
        },
        {
            "label": "FP03 Fuseki Provider Wipe Data",
            "type": "shell",
            "command": "fuseki/provider/delete_provider_fuseki.sh",
            "problemMatcher": []
        },
        {
            "label": "GC01 Consumer GraphDB Start ",
            "type": "shell",
            "options": {"cwd": "${workspaceFolder}/central-kg"},
            "runOptions": {},
            "command": "docker compose up central-platform-graphdb",
            "problemMatcher": []
        },
        {
            "label": "GC02 Consumer GraphDB Init repo",
            "type": "shell",
            "options": {"cwd": "${workspaceFolder}/central-kg/graphdb"},
            "command": "scripts/init-repo.sh",
            "problemMatcher": []
        },
        {
            "label": "GC03 Consumer GraphDB Wipe GraphDB",
            "type": "shell",
            "options": {"cwd": "${workspaceFolder}/central-kg/graphdb"},
            "command": "scripts/delete_data.sh",
            "problemMatcher": []
        },
        {
            "label": "GC04 Consumer GraphDB Stop",
            "type": "shell",
            "options": {"cwd": "${workspaceFolder}/central-kg"},
            "runOptions": {},
            "command": "docker compose down central-platform-graphdb",
            "problemMatcher": []
        },
        {
            "label": "DE02 Register Demo Datasets Provider",
            "type": "shell",
            "command": "scripts/demo_setup/register_provider_datasets.sh",
            "problemMatcher": []
        },
        {
            "label": "DE01 Load Dataset 1 Fuseki Provider",
            "type": "shell",
            "command": "fuseki/provider/load_data_provider.sh demo/dataset_1/subgraph_pc1pc2_external.ttl",
            "problemMatcher": []
        },
        {
            "label": "ST10 Start Issuer Service",
            "type": "shell",
            "command": "scripts/startups/start-issuer-service.sh",
            "problemMatcher": []
        },
        {
            "label": "ST20 Start IdentityHub Consumer",
            "type": "shell",
            "command": "scripts/startups/start-identityhub-consumer.sh",
            "problemMatcher": []
        },
        {
            "label": "ST21 Start IdentityHub Provider QNA",
            "type": "shell",
            "command": "scripts/startups/start-identityhub-provider-qna.sh",
            "problemMatcher": []
        },
        {
            "label": "ST22 Start IdentityHub Provider MS",
            "type": "shell",
            "command": "scripts/startups/start-identityhub-provider-ms.sh",
            "problemMatcher": []
        },
        {
            "label": "ST30 Start Connector Consumer",
            "type": "shell",
            "command": "scripts/startups/start-connector-consumer.sh",
            "problemMatcher": []
        },
        {
            "label": "ST31 Start Connector Provider QnA",
            "type": "shell",
            "command": "scripts/startups/start-connector-provider-qna.sh",
            "problemMatcher": []
        },
        {
            "label": "ST32 Start Connector Provider Manufacturing",
            "type": "shell",
            "command": "scripts/startups/start-connector-provider-manufacturing.sh",
            "problemMatcher": []
        },
        {
            "label": "ST41 Start Standalone Federated Catalog server",
            "type": "shell",
            "command": "scripts/startups/start-standalone-catalog.sh",
            "problemMatcher": []
        },
        {
            "label": "ST50 Do Seeding",
            "type": "shell",
            "command": "scripts/seed.sh",
            "problemMatcher": []
        },
        {
            "label": "ST60 Start Digital thread agent",
            "type": "shell",
            "command": "scripts/startups/start-digital-thread.sh",
            "problemMatcher": []
        },
        {
            "label": "ST98 Start Demo Services",
            "dependsOn":[
                "PC01 Postgres Consumer Start Postgres",
                "PC03 Postgres Consumer Delete inserted datasets",
                "FP01 Fuseki Provider Start ",
                "FP03 Fuseki Provider Wipe Data",
                "GD01 Start GraphDB",
                "GD04 Wipe GraphDB",
                "GD03 Create Inference GraphDB",
                "DE01 Load Dataset 1 Fuseki Provider",
                "ST60 Start Digital thread agent"
            ],
            "dependsOrder": "sequence" 
        },
        {
            "label": "ST99 Start All Processes",
            "dependsOn": [
                "ST10 Start Issuer Service",
                "ST20 Start IdentityHub Consumer",
                "ST21 Start IdentityHub Provider QNA",
                "ST22 Start IdentityHub Provider MS",
                "ST30 Start Connector Consumer",
                "ST31 Start Connector Provider QnA",
                "ST32 Start Connector Provider Manufacturing",
                "ST41 Start Standalone Federated Catalog server"
            ],
            "dependsOrder": "parallel",
            "problemMatcher": []
        }
    ]
}