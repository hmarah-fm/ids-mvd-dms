###############################################
# Federated Catalog with STS + Filesystem Vault
###############################################

# keycloak
keycloak_admin_user=admin
keycloak_admin_password=admin
keycloak_host=localhost
keycloak_port=5080
keycloak_realm=unimaas

# Participant identity
edc.participant.id=did:web:localhost%3A7083
edc.iam.issuer.id=did:web:localhost%3A7083
edc.iam.did.web.use.https=false
edc.iam.did.web.resolution.endpoint=http://localhost:7082/api/identity/v1alpha/did

# STS OAuth client
edc.iam.sts.oauth.client.id=did:web:localhost%3A7083
edc.iam.sts.oauth.token.url=http://localhost:7086/api/sts/token
edc.iam.sts.oauth.client.secret.alias=did:web:localhost%3A7083-sts-client-secret
edc.iam.sts.oauth.audience=did:web:localhost%3A10100
edc.iam.sts.oauth.scope=
edc.oauth.validation.audience.enabled=false

# Token signing
edc.iam.token.provider=privatekey
edc.iam.token.signer.privatekey.alias=did:web:localhost%3A7083-alias
edc.iam.token.verifier.publickey.id=did:web:localhost%3A7083#key-1

# Default API
web.http.port=8180 
web.http.path=/api

# Management API (Secrets API included)
web.http.management.port=8181
web.http.management.path=/api/management
web.http.management.auth.type=tokenbased
web.http.management.auth.key=password
edc.management.context.enabled=true

# DSP
web.http.protocol.port=8182
web.http.protocol.path=/api/dsp
edc.api.dsp.enabled=true
edc.dsp.callback.address=http://localhost:8182/api/dsp
edc.dsp.callback.auth.audience.validation.enabled=false
edc.dsp.auth.audience.validation.enabled=false

# DCP
edc.dcp.client.credentials.enabled=false

# Control API
web.http.control.port=8183
web.http.control.path=/api/control

# Catalog API
web.http.catalog.port=8184
web.http.catalog.path=/api/catalog
edc.api.catalog.enabled=true


