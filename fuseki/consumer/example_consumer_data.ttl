# ===== LOGISTIC ROUTES =====

<http://example.com/logisticroute/L2> a sc:LogisticRoute ;
    sc:name "L2" ;
    sc:hasStartingPoint <http://example.com/location/LOC003> ;
    sc:hasEndingPoint <http://example.com/location/LOC004> .

<http://example.com/logisticroute/L3> a sc:LogisticRoute ;
    sc:name "L3" ;
    sc:hasStartingPoint <http://example.com/location/LOC009> ;
    sc:hasEndingPoint <http://example.com/location/LOC004> .

