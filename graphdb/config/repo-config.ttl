@prefix : <http://www.ontotext.com/config/repository#>.
@prefix owlim: <http://www.ontotext.com/trree/owlim#>.
@prefix rep: <http://www.openrdf.org/config/repository#>.
@prefix sr: <http://www.openrdf.org/config/repository/sail#>.
@prefix sail: <http://www.openrdf.org/config/sail#>.

[] a rep:Repository ;
   rep:repositoryID "centralKG" ;
   rep:repositoryImpl [
      rep:repositoryType "graphdb:SailRepository" ;
      sr:sailImpl [
         sail:sailType "graphdb:Sail" ;

         # Inference ruleset
         owlim:ruleset "owl2-ql" ;

         # Required for SPARQL UPDATE
         owlim:enable-sail-updates "true" ;

         # Indexing options
         owlim:enablePredicateList "true" ;
         owlim:enableContextIndex "true" ;

         # Namespace configuration
         owlim:base-URL "http://unimaas-project.eu/kg/" ;
         owlim:defaultNS "http://unimaas-project.eu/kg/" ;

         # Storage configuration
         owlim:entity-index-size "20000000" ;
         owlim:entity-id-size "32" ;
         owlim:repository-type "file-repository" ;
      ]
   ].
