PREFIX  rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> 
PREFIX  xsd: <http://www.w3.org/2001/XMLSchema#> 
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#> 
PREFIX  owl: <http://www.w3.org/2002/07/owl#> 

PREFIX sc: <http://unimaas-project.eu/MSCOntology#> 
PREFIX local: <http://data.local/graph/>
PREFIX : <urn:example:>

SELECT DISTINCT ?pc1  ?pc2
#FROM NAMED  <http://data.local/graph/request-rdf-service-sparql>
#FROM NAMED  <http://data.local/graph/request-rdf-service-file>
WHERE
{
#GRAPH ?g 
    {
      ?pc1 sc:hasNextStep ?pc2.
    }  
} LIMIT 10